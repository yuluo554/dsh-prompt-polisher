# Build output (regenerated by pnpm build; the npm payload is chosen by
# package.json `files`, the git tree never carries it).
lib/

# Dependencies / runtime artifacts
node_modules/
*.log

# Secrets & private material — never tracked (desensitize-audit step 1).
.env
.env.*
**/_private/

# Isolated-store dirs from clean-environment verification (M5 release gate).
.clean-store/

# Local registry override (npmmirror for dev-box installs). Never tracked: a
# tracked .npmrc would push CI installs — and `npm publish` — onto a mirror
# that does not accept publishes.
.npmrc
